# Gemini / Google AI (primary LLM for complex commands)
# Get a key at https://aistudio.google.com/apikey — never commit real keys
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TIMEOUT=10

# Ollama (offline / local fallback — not used for wake word or simple commands)
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Keep model loaded in GPU (-1 = forever, 0 = unload, or e.g. 30m)
OLLAMA_KEEP_ALIVE=-1
OLLAMA_WARMUP_ENABLED=true
OLLAMA_TIMEOUT=120

# Fast Commands — skip any LLM for common desktop actions
FAST_COMMANDS_ENABLED=true

# Language: en | hi | hinglish (default response language when ambiguous)
DEFAULT_LANGUAGE=en

# Speech Recognition (tiny, base, small, medium, large-v3)
# WHISPER_LANGUAGE=auto enables multilingual (en/hi) detection
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=auto

# Wake Word (local only — never sent to Gemini or Ollama)
WAKE_WORD=jarvis
WAKE_WORD_ENABLED=true
WAKE_WORD_ENGINE=openwakeword
WAKE_WORD_THRESHOLD=0.3
WAKE_WORD_MODEL=hey_jarvis
LISTENING_ENABLED=true

# Global push-to-talk (Windows-wide). Examples: ctrl+space, ctrl+shift+j
GLOBAL_HOTKEY_ENABLED=true
GLOBAL_HOTKEY=ctrl+space

# Text-to-Speech (English Piper; Hindi uses Windows SAPI when available)
TTS_ENABLED=true
TTS_VOICE=en_US-lessac-medium
TTS_VOICE_HI=hi_IN-pratham-medium
TTS_SPEED=1.0

# Audio
MICROPHONE_INDEX=
SPEAKER_INDEX=
AUDIO_SAMPLE_RATE=16000
COMMAND_MAX_DURATION=8
COMMAND_SILENCE_TIMEOUT=0.8

# Assistant
JARVIS_NAME=Jarvis
ACTIVATION_SOUND=true
CONFIRM_DANGEROUS_ACTIONS=true
# Comma-separated actions that skip confirmation (e.g. shutdown,restart,sleep)
TRUSTED_COMMANDS=
# If true, Gemini may call run_terminal_command (still requires confirmation)
ALLOW_LLM_SHELL=false
CONVERSATION_CONTEXT_TURNS=6

# UI — default is system tray (use --window to show the dashboard)
UI_ENABLED=true
UI_ALWAYS_ON_TOP=true
UI_START_MINIMIZED=true

# Launch Jarvis at Windows sign-in (also toggle from tray → Settings)
START_WITH_WINDOWS=false

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# Paths
PROJECTS_CONFIG=config/projects.json
SCREENSHOTS_DIR=data/screenshots
APPS_CONFIG=config/apps.json
CONTACTS_CONFIG=config/contacts.json
WHATSAPP_COUNTRY_CODE=91
