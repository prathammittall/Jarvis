# Grok / xAI (primary LLM for complex commands)
# Get a key at https://console.x.ai — never commit real keys
GROK_ENABLED=true
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT=10

# Ollama (offline / local fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Keep model loaded in GPU (-1 = forever, 0 = unload, or e.g. 30m)
OLLAMA_KEEP_ALIVE=-1
OLLAMA_WARMUP_ENABLED=true
OLLAMA_TIMEOUT=120

# Fast Commands — skip any LLM for common desktop actions
FAST_COMMANDS_ENABLED=true

# Language: en | hi | hinglish (default response language when ambiguous)
DEFAULT_LANGUAGE=en

# Speech Recognition (tiny, base, small, medium, large-v3)
# WHISPER_LANGUAGE=auto enables multilingual (en/hi) detection
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=auto

# Wake Word
WAKE_WORD_ENABLED=true
WAKE_WORD_ENGINE=openwakeword
WAKE_WORD_THRESHOLD=0.3
WAKE_WORD_MODEL=hey_jarvis

# Text-to-Speech (English Piper; Hindi uses Windows SAPI when available)
TTS_ENABLED=true
TTS_VOICE=en_US-lessac-medium
TTS_VOICE_HI=hi_IN-pratham-medium
TTS_SPEED=1.0

# Audio
MICROPHONE_INDEX=
SPEAKER_INDEX=
AUDIO_SAMPLE_RATE=16000
COMMAND_MAX_DURATION=15
COMMAND_SILENCE_TIMEOUT=1.5

# Assistant
JARVIS_NAME=Jarvis
ACTIVATION_SOUND=true
CONFIRM_DANGEROUS_ACTIONS=true
CONVERSATION_CONTEXT_TURNS=6

# UI
UI_ENABLED=true
UI_ALWAYS_ON_TOP=true
UI_START_MINIMIZED=false

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# Paths
PROJECTS_CONFIG=config/projects.json
SCREENSHOTS_DIR=data/screenshots
