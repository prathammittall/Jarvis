# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Speech Recognition (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Wake Word
WAKE_WORD_ENABLED=true
WAKE_WORD_ENGINE=openwakeword
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_MODEL=hey_jarvis

# Text-to-Speech
TTS_ENABLED=true
TTS_VOICE=en_US-lessac-medium
TTS_SPEED=1.0

# Audio
MICROPHONE_INDEX=
SPEAKER_INDEX=
AUDIO_SAMPLE_RATE=16000
COMMAND_MAX_DURATION=15
COMMAND_SILENCE_TIMEOUT=1.5

# Assistant
JARVIS_NAME=Jarvis
ACTIVATION_SOUND=true
CONFIRM_DANGEROUS_ACTIONS=true
CONVERSATION_CONTEXT_TURNS=6

# UI
UI_ENABLED=true
UI_ALWAYS_ON_TOP=true
UI_START_MINIMIZED=false

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# Paths
PROJECTS_CONFIG=config/projects.json
SCREENSHOTS_DIR=data/screenshots
